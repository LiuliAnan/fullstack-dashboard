DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=devuser
DB_PASSWORD=devpass
DB_DATABASE=week1_env
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# All memberships/AI administrators are server-controlled; never supplied by clients.
# Empty mapping: local single-tenant mode. Nonempty mapping: unlisted users are denied AI access.
AI_DEFAULT_TENANT=default
AI_TENANT_USERS={}
AI_ADMIN_USER_IDS=
AI_SESSION_TTL_SECONDS=7200
AI_CHAT_TTL_SECONDS=600
AI_TASK_TTL_SECONDS=7200
AI_CHAT_CACHE_ENABLED=true
AI_CACHE_COMPANY_ENABLED=true
AI_CACHE_COMPANY_TTL_SECONDS=600
AI_CACHE_CHAT_ENABLED=true
# ai:llm_cache: is reserved only; no model-call cache implementation.
AI_MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
